# Loaded automatically by Vite for `npm run build` (production mode only,
# not `npm run dev`) -- see frontend/src/hooks/useRoomSync.ts. Not a secret,
# just the deployed WebSocket/REST API's public endpoints (template.yaml's
# WebSocketApi/DjangoApi resources, stack: mision-emprende, region: us-east-1).
VITE_WS_URL=wss://pbs033alub.execute-api.us-east-1.amazonaws.com/prod
VITE_API_URL=https://ljw4n47p5f.execute-api.us-east-1.amazonaws.com/prod/api

# API Gateway has no custom domain, so the app is served under the /prod
# stage path (e.g. https://<id>.execute-api.../prod/) -- built asset URLs
# need this prefix baked in (see vite.config.ts) or they 403 at the AWS
# edge instead of reaching the Lambda.
VITE_BASE_PATH=/prod/
